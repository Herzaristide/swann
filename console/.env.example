# Console d'administration — variables d'environnement (copier vers .env.local en dev)

# URL publique de la console (Better Auth : callbacks, cookies)
BETTER_AUTH_URL=http://localhost:3001
# Secret de session (openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-console-secret-change-me-dev-console

# Base `console` (sessions Better Auth uniquement)
CONSOLE_DATABASE_URL=postgresql://swann:swann@localhost:5432/console

# Keycloak : émetteur public des jetons et URL où lire la configuration OpenID
# (dans un conteneur : http://keycloak:8080/realms/swann)
OIDC_ISSUER=http://localhost:8080/realms/swann
OIDC_DISCOVERY_URL=http://localhost:8080/realms/swann
CONSOLE_CLIENT_ID=swann-console
CONSOLE_CLIENT_SECRET=dev-console-secret

# Corpus API (côté serveur uniquement : le navigateur passe par /api/corpus)
CORPUS_API_URL=http://localhost:8000
# Liseuse (liens « ouvrir dans la liseuse »)
READER_URL=http://localhost:3000
