# Préproduction : copier vers .env.preprod (jamais commité) et remplacer chaque
# change-me par une valeur aléatoire (openssl rand -base64 32).

# Adresse sous laquelle le navigateur joint la préprod (nom ou IP du réseau privé).
PREPROD_HOST=10.42.0.2

# Ports publiés : liseuse, console, Keycloak (connexion), Corpus API.
READER_PORT=8000
CONSOLE_PORT=8001
KEYCLOAK_PORT=8002
API_PORT=8003

POSTGRES_USER=swann
POSTGRES_PASSWORD=change-me
POSTGRES_DB=swann

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Utilisateur `lecteur` du realm importé (corpus:read, review, admin).
KEYCLOAK_DEV_USER_PASSWORD=change-me

READER_CLIENT_SECRET=change-me
READER_AUTH_SECRET=change-me
CONSOLE_CLIENT_SECRET=change-me
CONSOLE_AUTH_SECRET=change-me

# Stockage S3 (Garage) : clé `GK` + 24 hexa, secrets de 64 hexa
# (openssl rand -hex 12 pour la clé, openssl rand -hex 32 pour les secrets).
S3_ACCESS_KEY=GKchange-me
S3_SECRET_KEY=change-me-hex
GARAGE_RPC_SECRET=change-me-hex
