# Liseuse — variables d'environnement (copier vers .env.local en dev)

# URL publique de la liseuse (Better Auth : callbacks, cookies)
BETTER_AUTH_URL=http://localhost:3000
# Secret de session (openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me

# Base `reader` (données des lecteurs, sessions Better Auth)
READER_DATABASE_URL=postgresql://swann:swann@localhost:5432/reader

# Keycloak : émetteur public des jetons et URL où lire la configuration OpenID
# (dans un conteneur : http://keycloak:8080/realms/swann)
OIDC_ISSUER=http://localhost:8080/realms/swann
OIDC_DISCOVERY_URL=http://localhost:8080/realms/swann
READER_CLIENT_ID=swann-reader
READER_CLIENT_SECRET=dev-reader-secret

# Corpus API (côté serveur uniquement : le navigateur passe par /api/corpus)
CORPUS_API_URL=http://localhost:8000
